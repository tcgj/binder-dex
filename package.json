{
  "name": "binder-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n css,vite -c magenta,cyan \"npm:css:types:watch\" \"npm:dev:vite -- --host 0.0.0.0\"",
    "dev:vite": "vite",
    "build": "npm run css:types:check && tsc -b && vite build",
    "typecheck": "npm run css:types:check && tsc -b",
    "lint": "npm run css:types:check && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "css:types": "tcm src -p '**/*.module.css' -c -s",
    "css:types:watch": "tcm src -p '**/*.module.css' -c -w -s",
    "css:types:check": "tcm src -p '**/*.module.css' -c -l -s",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
